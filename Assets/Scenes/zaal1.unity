  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &1030440973
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1030440972}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 000ce70629e6dff45ae929e94718e34b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  portrait: {fileID: 21300000, guid: 769b61b39c473584cb81cdf5d449e34a, type: 3}
  speakerName: Opa Koos
  lines:
  - text: "Gefeliciteerd, dit is jouw allereerste zaal! Wat mooi om te zien dat je
      zo snel leert. Vroeger deed ik dit allemaal in m\u2019n eentje, maar jij gaat
      het vast nog beter doen."
  - text: "Laat ik je even wegwijs maken. Je ziet zo blauwe stoelen\u2026 die kun
      je kopen. Zodra je er eentje aanschaft, begint \u2019ie geld op te leveren.
      Elke minuut tikt er netjes een bedrag binnen. Dat noem ik nog eens makkelijk
      geld verdienen!"
  - text: Maar het blijft niet bij kopen alleen, hoor. Je kunt stoelen ook upgraden.
      Hoe beter de stoel, hoe meer inkomsten jij krijgt. Slim investeren, daar draait
      het om in mijn fabriek.
  - text: "Je ziet hier en daar misschien wat rommel op de grond liggen. Dat hoort
      erbij\u2026 vroeger ruimde ik dat allemaal op, maar nu mag jij dat doen. Met
      de E-toets pak je het zo op."
  - text: "Wil je het jezelf n\xF3g makkelijker maken? Koop dan de prullenbak van
      deze zaal. Zodra je die hebt, ontstaat er geen nieuwe troep meer. Scheelt een
      hoop bukken, dat kan ik je vertellen."
  - text: "En o ja, dat grote scherm daar\u2026 dat draait een instructievideo. Als
      het geluid je stoort, gebruik je gewoon de E-toets om het aan of uit te zetten.
      Heel handig wanneer je even rust in je oren wilt."
  - text: Zo, dat was je korte rondleiding. Maak er iets moois van, jongen. Hoe beter
      jij deze zaal runt, hoe sneller de rest van de fabriek ook van jou kan worden.
  videoPlayer: {fileID: 1947048084}
  startBonus: 300
